{
  "name": "@mach/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @mach/contracts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mach/contracts": "0.1.0",
    "@prisma/client": "6.12.0",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "vitest": "5.0.1"
  }
}
