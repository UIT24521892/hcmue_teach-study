generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
  SELF_LEARNER
  ADMIN
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum DocumentJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRUE_FALSE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole
  timezone     String    @default("Asia/Ho_Chi_Minh")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens     RefreshToken[]
  documents         Document[]
  questionRevisions QuestionRevision[] @relation("QuestionRevisionEditor")
  quizzes           Quiz[]
  quizAttempts      QuizAttempt[]

  @@index([role])
  @@map("users")
}

/// Metadata for an uploaded source file. The storage key is generated by the
/// server and is never exposed as a public/static URL.
model Document {
  id                     String         @id @default(cuid())
  ownerId                String         @map("owner_id")
  originalName           String         @map("original_name")
  storageKey             String         @unique @map("storage_key")
  extension              String
  mimeType               String         @map("mime_type")
  byteSize               Int            @map("byte_size")
  checksum               String
  status                 DocumentStatus @default(UPLOADED)
  extractedText          String?        @map("extracted_text") @db.Text
  characterCount         Int?           @map("character_count")
  pageCount              Int?           @map("page_count")
  processingErrorCode    String?        @map("processing_error_code")
  processingErrorMessage String?        @map("processing_error_message")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  deletedAt              DateTime?      @map("deleted_at")

  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs      DocumentJob[]
  questions Question[]

  @@index([ownerId, createdAt])
  @@index([ownerId, checksum])
  @@map("documents")
}

model DocumentJob {
  id           String            @id @default(cuid())
  documentId   String            @map("document_id")
  status       DocumentJobStatus @default(QUEUED)
  progress     Int               @default(0)
  attempt      Int               @default(0)
  maxAttempts  Int               @default(3) @map("max_attempts")
  activeKey    String?           @unique @map("active_key")
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at")
  startedAt    DateTime?         @map("started_at")
  completedAt  DateTime?         @map("completed_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([documentId, createdAt])
  @@index([status, createdAt])
  @@map("document_jobs")
}

model Question {
  id              String               @id @default(cuid())
  documentId      String               @map("document_id")
  generationJobId String               @map("generation_job_id")
  type            QuestionType
  prompt          String               @db.Text
  options         Json?
  correctAnswer   String               @map("correct_answer") @db.Text
  explanation     String               @db.Text
  difficulty      QuestionDifficulty
  reviewStatus    QuestionReviewStatus @default(PENDING_REVIEW) @map("review_status")
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  document      Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generationJob DocumentJob        @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  revisions     QuestionRevision[]
  quizItems     QuizQuestion[]

  @@index([documentId, reviewStatus, createdAt])
  @@map("questions")
}

model QuestionRevision {
  id             String   @id @default(cuid())
  questionId     String   @map("question_id")
  editorId       String   @map("editor_id")
  previousValues Json     @map("previous_values")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  editor   User     @relation("QuestionRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@index([questionId, createdAt])
  @@index([editorId])
  @@map("question_revisions")
}

/// A reusable set of approved questions. Drafts reference live questions;
/// publishing freezes every item into `QuizQuestion.snapshot`, so later edits
/// to the question bank never change a published quiz or its attempts.
model Quiz {
  id               String     @id @default(cuid())
  ownerId          String     @map("owner_id")
  title            String
  description      String?    @db.Text
  timeLimitSeconds Int?       @map("time_limit_seconds")
  status           QuizStatus @default(DRAFT)
  version          Int        @default(1)
  publishedAt      DateTime?  @map("published_at")
  archivedAt       DateTime?  @map("archived_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items    QuizQuestion[]
  attempts QuizAttempt[]

  @@index([ownerId, status, createdAt])
  @@map("quizzes")
}

/// `questionId` becomes null when the source question is deleted. A published
/// item keeps working from its snapshot; a draft item without a source is
/// ignored and blocks nothing.
model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String   @map("quiz_id")
  questionId String?  @map("question_id")
  position   Int
  snapshot   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  quiz     Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([quizId, position])
  @@unique([quizId, questionId])
  @@index([questionId])
  @@map("quiz_questions")
}

/// One learner's run through a published quiz. `items` copies the published
/// snapshot (answers included) when the attempt starts, so grading and review
/// never depend on the quiz or question bank afterwards. `activeKey` is set
/// only while in progress, making "one open attempt per learner and quiz" a
/// database guarantee.
model QuizAttempt {
  id           String            @id @default(cuid())
  quizId       String            @map("quiz_id")
  userId       String            @map("user_id")
  status       QuizAttemptStatus @default(IN_PROGRESS)
  activeKey    String?           @unique @map("active_key")
  items        Json
  totalCount   Int               @map("total_count")
  correctCount Int?              @map("correct_count")
  score        Int?
  startedAt    DateTime          @default(now()) @map("started_at")
  deadlineAt   DateTime?         @map("deadline_at")
  submittedAt  DateTime?         @map("submitted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([userId, quizId, createdAt])
  @@index([quizId, status])
  @@map("quiz_attempts")
}

/// Latest saved response per question position. `isCorrect` is filled when the
/// attempt is graded on submit.
model AttemptAnswer {
  id        String   @id @default(cuid())
  attemptId String   @map("attempt_id")
  position  Int
  response  String   @db.Text
  isCorrect Boolean? @map("is_correct")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, position])
  @@map("attempt_answers")
}

/// Rotating refresh tokens. Only a SHA-256 hash of the token is persisted, so a
/// database leak cannot be replayed against the API. `familyId` groups every
/// token descended from one login; presenting an already-rotated token revokes
/// the whole family (refresh token reuse detection).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
