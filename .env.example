# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1

# PostgreSQL (local development defaults used by compose.yml)
POSTGRES_USER=mach
POSTGRES_PASSWORD=mach_local_only
POSTGRES_DB=mach_learning
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mach:mach_local_only@localhost:5432/mach_learning?schema=public

# Redis is prepared for the background worker introduced in Phase 2.
REDIS_URL=redis://localhost:6379

# Development seed only. Replace locally; never use this value in production.
SEED_PASSWORD=ChangeMe123!

# AI and object storage providers are intentionally optional in Phase 0.
AI_PROVIDER=mock
AI_API_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
