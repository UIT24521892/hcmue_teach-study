# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1

# PostgreSQL (local development defaults used by compose.yml)
POSTGRES_USER=mach
POSTGRES_PASSWORD=mach_local_only
POSTGRES_DB=mach_learning
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mach:mach_local_only@localhost:5432/mach_learning?schema=public
# Integration tests ignore DATABASE_URL and use this dedicated disposable DB.
TEST_DATABASE_URL=postgresql://mach:mach_local_only@localhost:5432/mach_test?schema=public

# Redis is prepared for the background worker introduced in Phase 2.
REDIS_URL=redis://localhost:6379

# Auth. AUTH_ACCESS_TOKEN_SECRET is required in production and must be at least
# 32 characters; the value below is a local development placeholder only.
AUTH_ACCESS_TOKEN_SECRET=mach-local-development-access-token-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=mach_refresh

# Development seed only. Replace locally; never use this value in production.
SEED_PASSWORD=ChangeMe123!

# AI and object storage providers are intentionally optional in Phase 0.
AI_PROVIDER=mock
AI_API_KEY=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_EXTRACTED_TEXT_MAX_CHARACTERS=100000
DOCUMENT_JOB_MODE=inline
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_BACKOFF_MS=1000
DOCUMENT_AI_DAILY_QUOTA=20
DOCUMENT_TARGET_QUESTION_COUNT=3
